<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CourtBook</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

    <!-- Top Navigation -->
    <header class="sticky-top border-bottom" style="background-color: var(--background); border-color: var(--border) !important; box-shadow: 0 1px 0 rgba(0,0,0,0.05);">
        <div class="container-xl">
            <div class="d-flex align-items-center justify-content-between" style="height: 64px;">

                <!-- Logo -->
                <a asp-controller="Home" asp-action="Dashboard" class="d-flex align-items-center gap-2 text-decoration-none">
                    <div class="d-flex align-items-center justify-content-center rounded-2 p-2" style="background-color: var(--primary);">
                        <i class="bi bi-trophy-fill text-white" style="font-size: 1rem;"></i>
                    </div>
                    <span class="fw-bold d-none d-sm-block" style="color: var(--foreground); font-size: 1.125rem;">CourtBook</span>
                </a>

                <!-- Nav Links (Desktop) -->
                <nav class="d-none d-md-flex align-items-center gap-1">
                    <a asp-controller="Home" asp-action="Dashboard"
                           class="px-3 py-2 rounded-2 text-decoration-none fw-medium nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "nav-link-active" : "nav-link-inactive")"
                           style="font-size: 0.875rem;">
                        <i class="bi bi-speedometer2 me-1"></i> Home
                    </a>
                    <a asp-controller="Courts" asp-action="Index"
                           class="px-3 py-2 rounded-2 text-decoration-none fw-medium nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Courts" ? "nav-link-active" : "nav-link-inactive")"
                           style="font-size: 0.875rem;">
                        <i class="bi bi-journal-bookmark me-1"></i> Browse Courts
                    </a>
                    <a asp-controller="Reservations" asp-action="Index"
                           class="px-3 py-2 rounded-2 text-decoration-none fw-medium nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reservations" ? "nav-link-active" : "nav-link-inactive")"
                           style="font-size: 0.875rem;">
                        <i class="bi bi-calendar-check me-1"></i> My Reservations
                    </a>
                </nav>

                <!-- User Dropdown -->
                <div class="dropdown">
                    <button class="btn d-flex align-items-center gap-2 px-3 py-2 rounded-2"
                            style="background: transparent; border: none;"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        <div class="d-flex align-items-center justify-content-center rounded-circle fw-semibold text-white"
                             style="width: 32px; height: 32px; background-color: var(--primary); font-size: 0.875rem;">
                            @(User.Identity?.Name?.Substring(0, 1).ToUpper())
                        </div>
                        <span class="d-none d-sm-block fw-medium text-truncate"
                              style="color: var(--foreground); font-size: 0.875rem; max-width: 128px;">
                            @User.Identity?.Name
                        </span>
                        <i class="bi bi-chevron-down" style="color: var(--muted-foreground); font-size: 0.75rem;"></i>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end border rounded-3 py-1 mt-2"
                        style="background-color: var(--card); border-color: var(--border) !important; min-width: 192px; box-shadow: 0 12px 24px rgba(0,0,0,0.3);">
                        <li class="px-4 py-2 border-bottom" style="border-color: var(--border) !important;">
                            <p class="mb-0 fw-medium text-truncate" style="color: var(--foreground); font-size: 0.875rem;">
                                @User.Identity?.Name
                            </p>
                            <p class="mb-0 text-truncate" style="color: var(--muted-foreground); font-size: 0.75rem;">
                                @(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value)
                            </p>
                        </li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="dropdown-item d-flex align-items-center gap-2 py-2"
                                        style="color: var(--destructive); font-size: 0.875rem;">
                                    <i class="bi bi-box-arrow-right"></i>
                                    Logout
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>

            </div>
        </div>

        <!-- Mobile Bottom Nav -->
        <div class="d-md-none border-top d-flex" style="border-color: var(--border) !important;">
            <a asp-controller="Home" asp-action="Dashboard"
                   class="flex-fill d-flex flex-column align-items-center py-2 text-decoration-none mobile-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "mobile-nav-active" : "mobile-nav-inactive")"
                   style="font-size: 0.75rem;">
                <i class="bi bi-speedometer2 mb-1" style="font-size: 1.25rem;"></i>
                <span>Home</span>
            </a>
            <a asp-controller="Courts" asp-action="Index"
                   class="flex-fill d-flex flex-column align-items-center py-2 text-decoration-none mobile-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Courts" ? "mobile-nav-active" : "mobile-nav-inactive")"
                   style="font-size: 0.75rem;">
                <i class="bi bi-journal-bookmark mb-1" style="font-size: 1.25rem;"></i>
                <span>Browse Courts</span>
            </a>
            <a asp-controller="Reservations" asp-action="Index"
                   class="flex-fill d-flex flex-column align-items-center py-2 text-decoration-none mobile-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reservations" ? "mobile-nav-active" : "mobile-nav-inactive")"
                   style="font-size: 0.75rem;">
                <i class="bi bi-calendar-check mb-1" style="font-size: 1.25rem;"></i>
                <span>My Reservations</span>
            </a>
        </div>
    </header>

    <!-- TempData Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="container-xl pt-3">
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="container-xl pt-3">
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    <!-- Main Content -->
    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Validation Scripts -->
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>