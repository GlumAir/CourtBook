<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CourtBook Admin</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body style="background-color: var(--background);">

    <div class="d-flex min-vh-100">

        <!-- Desktop Sidebar -->
        <aside class="d-none d-lg-flex flex-column position-fixed top-0 start-0 bottom-0"
               style="width: 256px; background-color: var(--sidebar); border-right: 1px solid var(--sidebar-border); z-index: 100;">

            <!-- Sidebar Header -->
            <div class="p-4 border-bottom" style="border-color: var(--sidebar-border) !important;">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <div class="d-flex align-items-center justify-content-center rounded-2 p-2">
                        <img src="~/images/CourtBookLogo.png"
                             alt="CourtBook Logo"
                             style="height: 60px; width: auto;" />
                    </div>
                    <span class="fw-bold" style="color: var(--foreground); font-size: 1.125rem;">CourtBook</span>
                </div>
                <span class="fw-semibold text-uppercase ms-5"
                      style="font-size: 0.7rem; color: var(--primary); letter-spacing: 0.1em;">
                    Admin
                </span>
            </div>

            <!-- Nav Items -->
            <nav class="flex-grow-1 p-3 d-flex flex-column gap-1">
                <a asp-controller="AdminDashboard" asp-action="Index"
                       class="d-flex align-items-center gap-3 px-3 py-3 rounded-3 text-decoration-none fw-medium sidebar-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminDashboard" ? "sidebar-nav-active" : "sidebar-nav-inactive")"
                       style="font-size: 0.875rem;">
                    <i class="bi bi-speedometer2 flex-shrink-0" style="font-size: 1.125rem;"></i>
                    Dashboard
                </a>
                <a asp-controller="AdminCourts" asp-action="Index"
                       class="d-flex align-items-center gap-3 px-3 py-3 rounded-3 text-decoration-none fw-medium sidebar-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminCourts" ? "sidebar-nav-active" : "sidebar-nav-inactive")"
                       style="font-size: 0.875rem;">
                    <i class="bi bi-building flex-shrink-0" style="font-size: 1.125rem;"></i>
                    Courts
                </a>
                <a asp-controller="AdminReservations" asp-action="Index"
                       class="d-flex align-items-center gap-3 px-3 py-3 rounded-3 text-decoration-none fw-medium sidebar-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminReservations" ? "sidebar-nav-active" : "sidebar-nav-inactive")"
                       style="font-size: 0.875rem;">
                    <i class="bi bi-calendar-check flex-shrink-0" style="font-size: 1.125rem;"></i>
                    Reservations
                </a>
                <a asp-controller="AdminUsers" asp-action="Index"
                       class="d-flex align-items-center gap-3 px-3 py-3 rounded-3 text-decoration-none fw-medium sidebar-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminUsers" ? "sidebar-nav-active" : "sidebar-nav-inactive")"
                       style="font-size: 0.875rem;">
                    <i class="bi bi-people flex-shrink-0" style="font-size: 1.125rem;"></i>
                    Users
                </a>
            </nav>

            <!-- Admin Info + Logout -->
            <div class="p-4 border-top" style="border-color: var(--sidebar-border) !important;">
                <div class="d-flex align-items-center gap-3 mb-3 px-2">
                    <div class="d-flex align-items-center justify-content-center rounded-circle fw-semibold text-white flex-shrink-0"
                         style="width: 32px; height: 32px; background-color: #2563EB; font-size: 0.875rem;">
                        @(User.Identity?.Name?.Substring(0, 1).ToUpper())
                    </div>
                    <div class="overflow-hidden">
                        <p class="mb-0 fw-medium text-truncate"
                               style="color: var(--foreground); font-size: 0.875rem;">
                            @User.Identity?.Name
                        </p>
                        <p class="mb-0 text-truncate"
                               style="color: var(--muted-foreground); font-size: 0.75rem;">
                            @(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value)
                        </p>
                    </div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="btn w-100 d-flex align-items-center gap-2 px-3 py-2 rounded-2"
                            style="background: transparent; border: none; color: var(--destructive); font-size: 0.875rem;">
                        <i class="bi bi-box-arrow-right"></i>
                        Logout
                    </button>
                </form>
            </div>
        </aside>

        <!-- Mobile Sidebar Overlay -->
        <div class="offcanvas offcanvas-start d-lg-none"
             tabindex="-1"
             id="mobileSidebar"
             style="width: 256px; background-color: var(--sidebar); border-right: 1px solid var(--sidebar-border);">

            <div class="offcanvas-header border-bottom px-4 py-4"
                 style="border-color: var(--sidebar-border) !important;">
                <div class="d-flex flex-column">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <div class="d-flex align-items-center justify-content-center rounded-2 p-2"
                             style="background-color: var(--primary);">
                            <i class="bi bi-trophy-fill text-white" style="font-size: 1rem;"></i>
                        </div>
                        <span class="fw-bold" style="color: var(--foreground); font-size: 1.125rem;">CourtBook</span>
                    </div>
                    <span class="fw-semibold text-uppercase ms-5"
                          style="font-size: 0.7rem; color: var(--primary); letter-spacing: 0.1em;">
                        Admin
                    </span>
                </div>
                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="offcanvas"
                        aria-label="Close">
                </button>
            </div>

            <div class="offcanvas-body p-3 d-flex flex-column gap-1">
                <a asp-controller="AdminDashboard" asp-action="Index"
                       class="d-flex align-items-center gap-3 px-3 py-3 rounded-3 text-decoration-none fw-medium sidebar-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminDashboard" ? "sidebar-nav-active" : "sidebar-nav-inactive")"
                       style="font-size: 0.875rem;"
                       data-bs-dismiss="offcanvas">
                    <i class="bi bi-speedometer2 flex-shrink-0" style="font-size: 1.125rem;"></i>
                    Dashboard
                </a>
                <a asp-controller="AdminCourts" asp-action="Index"
                       class="d-flex align-items-center gap-3 px-3 py-3 rounded-3 text-decoration-none fw-medium sidebar-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminCourts" ? "sidebar-nav-active" : "sidebar-nav-inactive")"
                       style="font-size: 0.875rem;"
                       data-bs-dismiss="offcanvas">
                    <i class="bi bi-building flex-shrink-0" style="font-size: 1.125rem;"></i>
                    Courts
                </a>
                <a asp-controller="AdminReservations" asp-action="Index"
                       class="d-flex align-items-center gap-3 px-3 py-3 rounded-3 text-decoration-none fw-medium sidebar-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminReservations" ? "sidebar-nav-active" : "sidebar-nav-inactive")"
                       style="font-size: 0.875rem;"
                       data-bs-dismiss="offcanvas">
                    <i class="bi bi-calendar-check flex-shrink-0" style="font-size: 1.125rem;"></i>
                    Reservations
                </a>
                <a asp-controller="AdminUsers" asp-action="Index"
                       class="d-flex align-items-center gap-3 px-3 py-3 rounded-3 text-decoration-none fw-medium sidebar-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminUsers" ? "sidebar-nav-active" : "sidebar-nav-inactive")"
                       style="font-size: 0.875rem;"
                       data-bs-dismiss="offcanvas">
                    <i class="bi bi-people flex-shrink-0" style="font-size: 1.125rem;"></i>
                    Users
                </a>
            </div>
        </div>

        <!-- Main Content Area -->
        <div class="flex-grow-1 d-flex flex-column min-vh-100" style="margin-left: 0; margin-left: clamp(0px, 256px, 256px);">

            <!-- Mobile Header -->
            <div class="d-lg-none d-flex align-items-center gap-3 px-4 py-3 border-bottom"
                 style="background-color: var(--background); border-color: var(--border) !important;">
                <button class="btn p-2 rounded-2"
                        style="background: transparent; border: none; color: var(--muted-foreground);"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#mobileSidebar">
                    <i class="bi bi-list" style="font-size: 1.25rem;"></i>
                </button>
                <div class="d-flex align-items-center gap-2">
                    <div class="d-flex align-items-center justify-content-center rounded-2 p-1"
                         style="background-color: var(--primary);">
                        <i class="bi bi-trophy-fill text-white" style="font-size: 0.875rem;"></i>
                    </div>
                    <span class="fw-bold" style="color: var(--foreground);">CourtBook Admin</span>
                </div>
            </div>

            <!-- TempData Alerts -->
            @if (TempData["Success"] != null)
            {
                <div class="px-4 pt-4">
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="px-4 pt-4">
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                </div>
            }

            <!-- Page Content -->
            <main class="flex-grow-1 p-4">
                @RenderBody()
            </main>

        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>