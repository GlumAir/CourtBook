@model CourtBook.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register - CourtBook</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
            .auth-card {
                background: rgba(15, 23, 42, 0.78);
                backdrop-filter: blur(18px);
                -webkit-backdrop-filter: blur(18px);
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 1rem;
                padding: 2rem;
                box-shadow: 0 25px 50px rgba(0, 0, 0, 0.45), 0 0 30px rgba(22, 163, 74, 0.08);
            }

                .auth-card label {
                    color: #ffffff !important;
                }

                .auth-card a {
                    color: #3b82f6 !important;
                    text-decoration: none;
                }

                    .auth-card a:hover {
                        color: #60a5fa !important;
                    }

            .auth-input {
                width: 100%;
                padding: 0.875rem 1rem;
                background-color: rgba(51, 65, 85, 0.9);
                border: 1px solid rgba(148, 163, 184, 0.25);
                border-radius: 0.75rem;
                color: #ffffff;
                font-size: 1rem;
                outline: none;
                transition: border-color 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
            }

            .auth-input:focus {
                background-color: rgba(51, 65, 85, 1);
                border-color: rgba(22, 163, 74, 0.75);
                box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.22);
            }

            .auth-input::placeholder {
                color: rgba(203, 213, 225, 0.75);
            }

            .auth-input.is-invalid {
                border-color: var(--destructive);
            }

            .auth-input-wrapper {
                position: relative;
            }

            .auth-input.has-toggle {
                padding-right: 2.5rem;
            }

            .password-toggle {
                position: absolute;
                right: 0.75rem;
                top: 50%;
                transform: translateY(-50%);
                background: none;
                border: none;
                color: rgba(203, 213, 225, 0.8);
                cursor: pointer;
                padding: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: color 0.15s ease;
            }

                .password-toggle:hover {
                    color: #ffffff;
                }

            .error-alert {
                padding: 0.75rem 1rem;
                border-radius: 0.5rem;
                background-color: rgba(239, 68, 68, 0.15);
                border: 1px solid rgba(239, 68, 68, 0.3);
                color: #FCA5A5;
                font-size: 0.875rem;
            }

            .field-error {
                color: var(--destructive);
                font-size: 0.75rem;
                margin-top: 0.25rem;
            }

            .register-page {
                min-height: 100vh;
                position: relative;
                overflow-x: hidden;
                background-image: linear-gradient( rgba(2, 6, 23, 0.78), rgba(2, 6, 23, 0.82) ), url('/images/hero/Hero6.png');
                background-size: cover;
                background-position: center;
                background-repeat: no-repeat;
                background-attachment: fixed;
            }

                .register-page::before {
                    content: "";
                    position: fixed;
                    inset: 0;
                    background: radial-gradient( circle at center, rgba(22, 163, 74, 0.08), transparent 60% );
                    pointer-events: none;
                }
    </style>
</head>
<body class="register-page">

    <div class="min-vh-100 d-flex align-items-center justify-content-center px-3 py-5">
        <div class="w-100" style="max-width: 448px;">

            <!-- Logo -->
            <div class="d-flex flex-column align-items-center mb-4">
                <div class="d-flex align-items-center justify-content-center rounded-3 p-3 mb-3">
                    <img src="~/images/CourtBookLogo.png"
                         alt="CourtBook Logo"
                         style="height: 150px; width: auto; filter: drop-shadow(0 0 20px rgba(22,163,74,.35));" />
                </div>
                <h1 class="fw-bold mb-1" style="color: var(--foreground); font-size: 1.5rem;">
                    Create Account
                </h1>
                <p class="mb-0" style="color: var(--muted-foreground); font-size: 0.875rem;">
                    Join CourtBook today
                </p>
            </div>

            <!-- Card -->
            <div class="auth-card">
                <form asp-action="Register" asp-controller="Account" method="post">
                    @Html.AntiForgeryToken()

                    <!-- General Error -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="ModelOnly" class="error-alert mb-4"></div>
                    }

                    <!-- Full Name -->
                    <div class="mb-4">
                        <label asp-for="FullName"
                               class="form-label fw-medium mb-2"
                               style="color: var(--foreground); font-size: 0.875rem;">
                            Full Name
                        </label>
                        <input asp-for="FullName"
                               type="text"
                               placeholder="Juan Dela Cruz"
                               class="auth-input @(ViewData.ModelState["FullName"]?.Errors.Count > 0 ? "is-invalid" : "")" />
                        <span asp-validation-for="FullName" class="field-error d-block"></span>
                    </div>

                    <!-- Email -->
                    <div class="mb-4">
                        <label asp-for="Email"
                               class="form-label fw-medium mb-2"
                               style="color: var(--foreground); font-size: 0.875rem;">
                            Email
                        </label>
                        <input asp-for="Email"
                               type="email"
                               placeholder="you@example.com"
                               class="auth-input @(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "is-invalid" : "")" />
                        <span asp-validation-for="Email" class="field-error d-block"></span>
                    </div>

                    <!-- Password -->
                    <div class="mb-4">
                        <label asp-for="Password"
                               class="form-label fw-medium mb-2"
                               style="color: var(--foreground); font-size: 0.875rem;">
                            Password
                        </label>
                        <div class="auth-input-wrapper">
                            <input asp-for="Password"
                                   type="password"
                                   id="passwordInput"
                                   placeholder="••••••••"
                                   class="auth-input has-toggle @(ViewData.ModelState["Password"]?.Errors.Count > 0 ? "is-invalid" : "")" />
                            <button type="button"
                                    class="password-toggle"
                                    id="togglePassword"
                                    aria-label="Toggle password visibility">
                                <i class="bi bi-eye" id="togglePasswordIcon" style="font-size: 1rem;"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="field-error d-block"></span>
                    </div>

                    <!-- Confirm Password -->
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword"
                               class="form-label fw-medium mb-2"
                               style="color: var(--foreground); font-size: 0.875rem;">
                            Confirm Password
                        </label>
                        <div class="auth-input-wrapper">
                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   id="confirmPasswordInput"
                                   placeholder="••••••••"
                                   class="auth-input has-toggle @(ViewData.ModelState["ConfirmPassword"]?.Errors.Count > 0 ? "is-invalid" : "")" />
                            <button type="button"
                                    class="password-toggle"
                                    id="toggleConfirm"
                                    aria-label="Toggle confirm password visibility">
                                <i class="bi bi-eye" id="toggleConfirmIcon" style="font-size: 1rem;"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="field-error d-block"></span>
                    </div>

                    <!-- Submit -->
                    <button type="submit"
                            class="btn w-100 py-3 fw-semibold rounded-3"
                            style="font-size: 1rem; background-color: #16a34a; color: #ffffff; border: none; box-shadow: 0 0 25px rgba(22,163,74,.35);">
                        Register
                    </button>
                </form>

                <!-- Login Link -->
                <p class="text-center mt-4 mb-0"
                       style="color: var(--muted-foreground); font-size: 0.875rem;">
                    Already have an account?
                    <a asp-controller="Account" asp-action="Login"
                           class="fw-medium"
                           style="color: #2563EB;">
                        Login
                    </a>
                </p>
            </div>

        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Validation Scripts -->
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Password toggle
        const togglePassword = document.getElementById('togglePassword');
        const passwordInput = document.getElementById('passwordInput');
        const togglePasswordIcon = document.getElementById('togglePasswordIcon');

        togglePassword.addEventListener('click', function () {
        const isPassword = passwordInput.type === 'password';
        passwordInput.type = isPassword ? 'text' : 'password';
        togglePasswordIcon.className = isPassword
        ? 'bi bi-eye-slash'
        : 'bi bi-eye';
        togglePasswordIcon.style.fontSize = '1rem';
        });

        // Confirm password toggle
        const toggleConfirm = document.getElementById('toggleConfirm');
        const confirmPasswordInput = document.getElementById('confirmPasswordInput');
        const toggleConfirmIcon = document.getElementById('toggleConfirmIcon');

        toggleConfirm.addEventListener('click', function () {
        const isPassword = confirmPasswordInput.type === 'password';
        confirmPasswordInput.type = isPassword ? 'text' : 'password';
        toggleConfirmIcon.className = isPassword
        ? 'bi bi-eye-slash'
        : 'bi bi-eye';
        toggleConfirmIcon.style.fontSize = '1rem';
        });
    </script>

</body>
</html>