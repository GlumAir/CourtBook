@model CourtBook.ViewModels.CourtListViewModel
@{
    ViewData["Title"] = "Browse Courts";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="container-xl py-4">

    <!-- Header -->
    <div class="page-header mb-4">
        <h1 class="fw-bold" style="color: var(--foreground); font-size: 1.875rem;">
            Browse Courts
        </h1>
        <p class="page-subtitle">Find and book the perfect court for your game.</p>
    </div>

    <!-- Filter Pills -->
    <div class="d-flex gap-2 flex-wrap mb-4">
        <a asp-controller="Courts" asp-action="Index"
               class="filter-pill @(string.IsNullOrEmpty(Model.SelectedSport) ? "active" : "")">
            All
        </a>
        <a asp-controller="Courts" asp-action="Index" asp-route-sport="Badminton"
               class="filter-pill @(Model.SelectedSport == "Badminton" ? "active" : "")">
            Badminton
        </a>
        <a asp-controller="Courts" asp-action="Index" asp-route-sport="Pickleball"
               class="filter-pill @(Model.SelectedSport == "Pickleball" ? "active" : "")">
            Pickleball
        </a>
    </div>

    <!-- Court Grid -->
    @if (!Model.Courts.Any())
    {
        <!-- Empty State -->
        <div class="rounded-3 border p-5 text-center"
             style="background-color: var(--card); border-color: var(--border) !important;">
            <div class="mb-3" style="color: var(--muted-foreground); font-size: 3rem; opacity: 0.4;">
                <i class="bi bi-journal-x"></i>
            </div>
            <h5 class="fw-semibold mb-2" style="color: var(--foreground);">
                No courts found
            </h5>
            <p class="mb-0" style="color: var(--muted-foreground); font-size: 0.875rem;">
                No @(Model.SelectedSport ?? "") courts are currently available.
            </p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var court in Model.Courts)
            {
                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="court-card border"
                         style="border-color: var(--border) !important;">

                        <!-- Top Row: Sport Badge + Availability -->
                        <div class="d-flex align-items-start justify-content-between mb-3">
                            @if (court.SportType == CourtBook.Models.SportType.Badminton)
                            {
                                <span class="badge-badminton">Badminton</span>
                            }
                            else
                            {
                                <span class="badge-pickleball">Pickleball</span>
                            }
                            <div class="d-flex align-items-center gap-2">
                                <span class="availability-dot"></span>
                                <span class="fw-medium"
                                      style="color: var(--color-success); font-size: 0.75rem;">
                                    Available
                                </span>
                            </div>
                        </div>

                        <!-- Court Name -->
                        <h3 class="court-name">@court.Name</h3>

                        <!-- Operating Hours -->
                        <div class="d-flex align-items-center gap-2 mb-2 court-hours">
                            <i class="bi bi-clock" style="color: var(--border);"></i>
                            @court.OperatingHours
                        </div>

                        <!-- Price -->
                        <div class="d-flex align-items-center gap-1 court-price mb-0">
                            <i class="bi bi-currency-exchange"
                               style="color: var(--primary); font-size: 0.875rem;"></i>
                            <span class="fw-semibold" style="color: var(--foreground);">
                                &#8369;@court.PricePerHour.ToString("N0")
                            </span>
                            <span style="color: var(--muted-foreground); font-size: 0.875rem;">
                                / hour
                            </span>
                        </div>

                        <!-- Book Now Button -->
                        <div class="card-actions">
                            <a asp-controller="Reservations"
                                   asp-action="Book"
                                   asp-route-courtId="@court.Id"
                                   class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-2 py-2 rounded-3 fw-semibold"
                                   style="font-size: 0.875rem;">
                                Book Now
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </div>

                    </div>
                </div>
            }
        </div>
    }

</div>