@model List<CourtBook.ViewModels.ReservationCardViewModel>
@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="overflow-hidden position-relative border-bottom d-flex align-items-center justify-content-center text-center"
     style="min-height: calc(100vh - 80px); 
            background: linear-gradient(to bottom, rgba(15, 23, 42, 0.65), rgba(15, 23, 42, 0.85)), 
                        url('https://images.unsplash.com/photo-1775993167393-f2add1f8eec2?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=1920&q=80'); 
            background-size: cover; 
            background-position: center; 
            background-attachment: fixed;
            margin-top: -24px; /* Counteracts parent container layout padding if necessary */">
    
    <div class="position-relative px-4 py-5 z-1 animate-fade-in" style="max-width: 750px;">
        <div class="d-inline-flex align-items-center gap-2 mb-3 px-3 py-1.5 rounded-pill"
             style="background-color: rgba(22, 163, 74, 0.2); border: 1px solid rgba(22, 163, 74, 0.4); color: #4ADE80; font-size: 0.875rem; font-weight: 500;">
            <i class="bi bi-trophy-fill"></i>
            CourtBook Player Dashboard
        </div>

        <p class="mb-2 text-uppercase tracking-wider fw-semibold" style="color: rgba(255, 255, 255, 0.6); font-size: 0.9rem; letter-spacing: 0.08em;">
            Welcome back,
        </p>
        
        <h1 class="fw-bold mb-3 text-white" style="font-size: clamp(2.25rem, 5vw, 3.5rem); line-height: 1.2;">
            @(ViewData["Username"] as string ?? User.Identity?.Name) &#128075;
        </h1>
        
        <p class="mb-4 fs-5" style="color: var(--muted-foreground); max-width: 550px; margin-left: auto; margin-right: auto;">
            Ready to get back on the court? Your next epic match is just a few clicks away.
        </p>

        <a href="#dashboard-actions" class="btn btn-success px-4 py-3 fw-semibold rounded-3 shadow-lg transition-all"
           style="background-color: var(--primary); border: none; font-size: 1rem;"
           onmouseover="this.style.backgroundColor='#15803d'"
           onmouseout="this.style.backgroundColor='var(--primary)'">
            Get Started <i class="bi bi-arrow-down ms-2"></i>
        </a>
    </div>
</div>

<div class="container-xl py-5" id="dashboard-actions" style="scroll-margin-top: 20px;">

    <div class="row g-4 mb-5">

        <div class="col-12 col-sm-6">
            <div class="h-100 rounded-3 border action-card overflow-hidden d-flex flex-column"
                 style="background-color: var(--card); border-color: var(--border) !important; transition: all 0.2s ease;">
                
                <img src="https://images.unsplash.com/photo-1626224583764-f87db24ac4ea?q=80&w=600&auto=format&fit=crop" 
                     alt="Browse Courts Banner" 
                     class="w-100" 
                     style="height: 180px; object-fit: cover; display: block;" />

                <div class="p-4 flex-grow-1 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center justify-content-center rounded-3 mb-3"
                             style="width: 48px; height: 48px; background-color: rgba(22,163,74,0.15);">
                            <i class="bi bi-journal-bookmark" style="color: var(--primary); font-size: 1.375rem;"></i>
                        </div>
                        <h3 class="fw-semibold mb-1" style="color: var(--foreground); font-size: 1.125rem;">
                            Browse Courts
                        </h3>
                        <p class="mb-4" style="color: var(--muted-foreground); font-size: 0.875rem;">
                            Find and book available Badminton or Pickleball courts.
                        </p>
                    </div>
                    <a asp-controller="Courts" asp-action="Index"
                       class="btn btn-primary d-inline-flex align-items-center justify-content-center gap-2 py-2.5 rounded-3 fw-semibold text-decoration-none w-100"
                       style="background-color: var(--primary); color: #ffffff; border: none; font-size: 0.875rem;"
                       onmouseover="this.style.backgroundColor='#15803d'"
                       onmouseout="this.style.backgroundColor='var(--primary)'">
                        Browse Courts
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6">
            <div class="h-100 rounded-3 border action-card overflow-hidden d-flex flex-column"
                 style="background-color: var(--card); border-color: var(--border) !important; transition: all 0.2s ease;">
                
                <img src="https://images.unsplash.com/photo-1599447421416-3414500d18a5?q=80&w=600&auto=format&fit=crop" 
                     alt="My Reservations Banner" 
                     class="w-100" 
                     style="height: 180px; object-fit: cover; display: block;" />

                <div class="p-4 flex-grow-1 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center justify-content-center rounded-3 mb-3"
                             style="width: 48px; height: 48px; background-color: rgba(37,99,235,0.15);">
                            <i class="bi bi-calendar-check" style="color: #2563EB; font-size: 1.375rem;"></i>
                        </div>
                        <h3 class="fw-semibold mb-1" style="color: var(--foreground); font-size: 1.125rem;">
                            My Reservations
                        </h3>
                        <p class="mb-4" style="color: var(--muted-foreground); font-size: 0.875rem;">
                            View your upcoming and past court reservations.
                        </p>
                    </div>
                    <a asp-controller="Reservations" asp-action="Index"
                       class="btn btn-primary d-inline-flex align-items-center justify-content-center gap-2 py-2.5 rounded-3 fw-semibold text-decoration-none w-100"
                       style="background-color: #2563EB; color: #ffffff; border: none; font-size: 0.875rem;"
                       onmouseover="this.style.backgroundColor='#1146be'"
                       onmouseout="this.style.backgroundColor='#2563EB'">
                        View Reservations
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
            </div>
        </div>

    </div>

    <div>
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h2 class="fw-bold mb-0" style="color: var(--foreground); font-size: 1.25rem;">
                Upcoming Reservations
            </h2>
            @if (Model.Any())
            {
                <a asp-controller="Reservations" asp-action="Index"
                   class="d-inline-flex align-items-center gap-1 text-decoration-none"
                   style="color: #2563EB; font-size: 0.875rem;">
                    View all <i class="bi bi-chevron-right"></i>
                </a>
            }
        </div>

        @if (!Model.Any())
        {
            <div class="rounded-3 border p-5 text-center"
                 style="background-color: var(--card); border-color: var(--border) !important;">
                <div class="mb-3" style="color: var(--muted-foreground); font-size: 3rem; opacity: 0.4;">
                    <i class="bi bi-calendar-x"></i>
                </div>
                <h5 class="fw-semibold mb-2" style="color: var(--foreground);">
                    No upcoming reservations
                </h5>
                <p class="mb-4" style="color: var(--muted-foreground); font-size: 0.875rem;">
                    You don't have any upcoming reservations right now. Book a court to get started!
                </p>
                <a asp-controller="Courts" asp-action="Index"
                   class="d-inline-flex align-items-center gap-2 px-4 py-2 rounded-3 fw-semibold text-decoration-none"
                   style="background-color: var(--primary); color: #ffffff; font-size: 0.875rem;">
                    Browse Courts
                    <i class="bi bi-chevron-right"></i>
                </a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var res in Model)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="rounded-3 border p-4 h-100"
                             style="background-color: var(--card); border-color: var(--border) !important;">

                            <div class="d-flex align-items-center justify-content-between mb-3">
                                @if (res.SportType == CourtBook.Models.SportType.Badminton)
                                {
                                    <span class="badge-badminton">Badminton</span>
                                }
                                else
                                {
                                    <span class="badge-pickleball">Pickleball</span>
                                }

                                @switch (res.Status)
                                {
                                    case CourtBook.Models.ReservationStatus.Confirmed:
                                        <span class="badge-confirmed">Confirmed</span>
                                        break;
                                    case CourtBook.Models.ReservationStatus.Cancelled:
                                        <span class="badge-cancelled">Cancelled</span>
                                        break;
                                    case CourtBook.Models.ReservationStatus.Completed:
                                        <span class="badge-completed">Completed</span>
                                        break;
                                }
                            </div>

                            <h3 class="fw-semibold mb-3" style="color: var(--foreground); font-size: 1.125rem;">
                                @res.CourtName
                            </h3>

                            <div class="d-flex flex-column gap-2">
                                <div class="d-flex align-items-center gap-2" style="color: var(--muted-foreground); font-size: 0.875rem;">
                                    <i class="bi bi-calendar3" style="color: var(--border);"></i>
                                    @res.Date.ToString("ddd, MMM d, yyyy")
                                </div>
                                <div class="d-flex align-items-center gap-2" style="color: var(--muted-foreground); font-size: 0.875rem;">
                                    <i class="bi bi-clock" style="color: var(--border);"></i>
                                    @res.StartTime – @res.EndTime
                                </div>
                                <div class="d-flex align-items-center gap-2" style="color: var(--muted-foreground); font-size: 0.875rem;">
                                    <i class="bi bi-currency-exchange" style="color: var(--border);"></i>
                                    &#8369;@res.TotalAmount.ToString("N0")
                                    @if (res.PaymentStatus == CourtBook.Models.PaymentStatus.Paid)
                                    {
                                        <span class="badge-paid">Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge-unpaid">Unpaid</span>
                                    }
                                </div>
                            </div>

                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    /* Clean interactive hover behaviors */
    .action-card {
        transform: translateY(0);
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
    }
    .action-card:hover {
        border-color: rgba(22, 163, 74, 0.45) !important;
        transform: translateY(-4px);
        box-shadow: 0 12px 20px -8px rgba(0,0,0,0.15);
    }
    .transition-all {
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    html {
        scroll-behavior: smooth;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in {
        animation: fadeIn 0.6s ease-out forwards;
    }
</style>