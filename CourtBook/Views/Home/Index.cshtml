            }

            .hero-badge {
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                background-color: rgba(22, 163, 74, 0.2);
                border: 1px solid rgba(22, 163, 74, 0.4);
                color: #4ADE80;
                padding: 0.375rem 1rem;
                border-radius: 999px;
                font-size: 0.875rem;
                font-weight: 500;
                margin-bottom: 1.5rem;
            }

            .hero-title {
                font-size: clamp(2.5rem, 6vw, 3.75rem);
                font-weight: 700;
                color: #ffffff;
                line-height: 1.15;
                margin-bottom: 1.25rem;
            }

