<style>
    .pulse-dot {
        --pulse-r: 22;
        --pulse-g: 163;
        --pulse-b: 74;
        --pulse-delay: 0s;
        --pulse-size: 8px;

        display: inline-block;
        width: var(--pulse-size);
        height: var(--pulse-size);
        border-radius: 50%;
        background-color: rgb(var(--pulse-r), var(--pulse-g), var(--pulse-b));
        position: relative;
        animation: pulse-ring 2.2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
        animation-delay: var(--pulse-delay);
        transform: translateZ(0);
    }

    .pulse-dot--green  { --pulse-r: 22;  --pulse-g: 163; --pulse-b: 74; }
    .pulse-dot--yellow { --pulse-r: 245; --pulse-g: 158; --pulse-b: 11; --pulse-delay: 0.5s; }
    .pulse-dot--red    { --pulse-r: 239; --pulse-g: 68;  --pulse-b: 68; --pulse-delay: 1s; }

    /* 👇 Double @@ escapes the Razor parser */
    @@keyframes pulse-ring {
        0% {
            transform: scale(1) translateZ(0);
            box-shadow: 0 0 0 0 rgba(var(--pulse-r), var(--pulse-g), var(--pulse-b), 0.6);
        }
        65% {
            transform: scale(1.25) translateZ(0);
            box-shadow: 0 0 0 10px rgba(var(--pulse-r), var(--pulse-g), var(--pulse-b), 0);
        }
        100% {
            transform: scale(1) translateZ(0);
            box-shadow: 0 0 0 0 rgba(var(--pulse-r), var(--pulse-g), var(--pulse-b), 0);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .pulse-dot {
            animation: none;
            box-shadow: 0 0 0 3px rgba(var(--pulse-r), var(--pulse-g), var(--pulse-b), 0.35);
            transform: scale(1) translateZ(0);
        }
    }
</style>

<!-- Usage 
<span class="pulse-dot pulse-dot--green" aria-hidden="true"></span> Active
<span class="pulse-dot pulse-dot--yellow" aria-hidden="true"></span> Pending
<span class="pulse-dot pulse-dot--red" aria-hidden="true"></span> Alert
-->


    <style>
    .unwritten-rules {
        max-width: 1200px;
        margin: 0 auto;
        padding: 3rem 1.5rem;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    }

    .unwritten-rules h2 {
        font-size: clamp(1.75rem, 4vw, 2.25rem);
        font-weight: 800;
        margin: 0 0 2.5rem;
        text-align: center;
        color: #0f172a;
        letter-spacing: -0.02em;
    }

    .rules-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
    }

    .rule-card {
        background: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.08), 0 2px 4px -2px rgb(0 0 0 / 0.06);
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease;
        display: flex;
        flex-direction: column;
        border: 1px solid #e2e8f0;
    }

    .rule-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 24px -8px rgb(0 0 0 / 0.12), 0 4px 8px -4px rgb(0 0 0 / 0.08);
    }

    .rule-image {
        width: 100%;
        height: 200px;
        object-fit: cover;
        background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
        display: block;
    }

    .rule-content {
        padding: 1.5rem;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .rule-badge {
        display: inline-block;
        background: #f1f5f9;
        color: #475569;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 0.25rem 0.6rem;
        border-radius: 8px;
        width: fit-content;
        margin-bottom: 0.75rem;
        letter-spacing: 0.05em;
    }

    .rule-content h3 {
        margin: 0 0 0.5rem;
        font-size: 1.25rem;
        font-weight: 700;
        color: #0f172a;
        line-height: 1.3;
    }

    .rule-content p {
        margin: 0;
        color: #475569;
        line-height: 1.6;
        flex: 1;
    }

    /* 👇 Razor-safe media queries */
    @@media (prefers-color-scheme: dark) {
        .unwritten-rules h2 { color: #f8fafc; }
        .rule-card { background: #1e293b; border-color: #334155; }
        .rule-badge { background: #334155; color: #cbd5e1; }
        .rule-content h3 { color: #f8fafc; }
        .rule-content p { color: #94a3b8; }
        .rule-image { background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); }
    }

    @@media (max-width: 640px) {
        .unwritten-rules { padding: 2rem 1rem; }
        .rules-grid { grid-template-columns: 1fr; gap: 1.5rem; }
        .rule-image { height: 180px; }
        .rule-content { padding: 1.25rem; }
    }
</style>












