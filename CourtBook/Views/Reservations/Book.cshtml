@model CourtBook.ViewModels.BookCourtViewModel
@{
    ViewData["Title"] = "Book a Court";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="container-xl py-4">

    <div class="mb-4">
        <a asp-controller="Courts" asp-action="Index"
           class="d-inline-flex align-items-center gap-2 mb-3 text-decoration-none"
           style="color: var(--muted-foreground); font-size: 0.875rem; transition: color 0.15s ease;"
           onmouseover="this.style.color='var(--foreground)'"
           onmouseout="this.style.color='var(--muted-foreground)'">
            <i class="bi bi-chevron-left"></i>
            Back to Courts
        </a>
        <h1 class="fw-bold mb-1" style="color: var(--foreground); font-size: 1.875rem;">
            Book a Court
        </h1>
        <p class="mb-0" style="color: var(--muted-foreground);">@Model.CourtName</p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert mb-4"
             style="background-color: rgba(239,68,68,0.15); border: 1px solid rgba(239,68,68,0.3); color: #FCA5A5; border-radius: 0.5rem;">
            <div asp-validation-summary="All"></div>
        </div>
    }

    <div class="row g-4">

        <div class="col-12 col-lg-7">

            <div class="rounded-3 border p-4 mb-4"
                 style="background-color: var(--card); border-color: var(--border) !important;">
                <h2 class="fw-semibold d-flex align-items-center gap-2 mb-4"
                    style="color: var(--foreground); font-size: 1.125rem;">
                    <i class="bi bi-calendar3" style="color: var(--primary);"></i>
                    Select a Date
                </h2>

                <form method="get"
                      asp-controller="Reservations"
                      asp-action="Book"
                      id="dateForm">
                    <input type="hidden" name="courtId" value="@Model.CourtId" />
                    <input type="date"
                           name="date"
                           id="datePicker"
                           value="@Model.SelectedDate?.ToString("yyyy-MM-dd")"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")"
                           class="form-control"
                           style="background-color: var(--input-background); border-color: var(--border); color: var(--foreground); border-radius: 0.75rem; padding: 0.625rem 1rem; max-width: 280px;"
                           onchange="this.form.submit()" />
                </form>
            </div>

            @if (Model.SelectedDate.HasValue && Model.TimeSlots.Any())
            {
                <div class="rounded-3 border p-4"
                     style="background-color: var(--card); border-color: var(--border) !important;">
                    <h2 class="fw-semibold d-flex align-items-center gap-2 mb-1"
                        style="color: var(--foreground); font-size: 1.125rem;">
                        <i class="bi bi-clock" style="color: var(--primary);"></i>
                        Select Time Slots
                    </h2>
                    <p class="mb-4" style="color: var(--muted-foreground); font-size: 0.875rem;">
                        You can select multiple hours/time blocks for your booking.
                    </p>

                    <div class="row g-3 mb-4">
                        @foreach (var slot in Model.TimeSlots)
                        {
                            <div class="col-6 col-sm-4 col-md-3">
                                @if (slot.IsAvailable)
                                {
                                    <button type="button"
                                            class="time-slot w-100 slot-btn text-start p-3 position-relative border rounded-3"
                                            style="background-color: transparent; color: var(--foreground); transition: all 0.2s;"
                                            data-raw-value="@slot.StartTime-@slot.EndTime"
                                            data-display-text="@slot.DisplayStart - @slot.DisplayEnd"
                                            onclick="toggleSlotSelection(this)">
                                        <div class="fw-semibold" style="font-size: 0.95rem;">@slot.DisplayStart</div>
                                        <div style="font-size: 0.75rem; opacity: 0.7;">to @slot.DisplayEnd</div>
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            class="time-slot time-slot-taken w-100 text-start p-3 border rounded-3 opacity-50"
                                            style="background-color: var(--secondary); color: var(--muted-foreground);"
                                            disabled>
                                        <div class="fw-semibold" style="font-size: 0.95rem;">@slot.DisplayStart</div>
                                        <div style="font-size: 0.75rem;">to @slot.DisplayEnd</div>
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <div class="d-flex align-items-center gap-4"
                         style="font-size: 0.75rem; color: var(--muted-foreground);">
                        <div class="d-flex align-items-center gap-2">
                            <div style="width: 12px; height: 12px; border-radius: 3px; border: 1px solid var(--border);"></div>
                            Available
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <div style="width: 12px; height: 12px; border-radius: 3px; background-color: var(--primary);"></div>
                            Selected
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <div style="width: 12px; height: 12px; border-radius: 3px; background-color: var(--secondary); opacity: 0.5;"></div>
                            Taken
                        </div>
                    </div>
                </div>
            }
            else if (Model.SelectedDate.HasValue && !Model.TimeSlots.Any())
            {
                <div class="rounded-3 border p-4 text-center"
                     style="background-color: var(--card); border-color: var(--border) !important;">
                    <i class="bi bi-clock-history mb-3"
                       style="font-size: 2.5rem; color: var(--muted-foreground); opacity: 0.4;"></i>
                    <p style="color: var(--muted-foreground); font-size: 0.875rem;">
                        No time slots available for this date.
                    </p>
                </div>
            }

        </div>

        <div class="col-12 col-lg-5">
            <div class="rounded-3 border p-4"
                 style="background-color: var(--card); border-color: var(--border) !important; position: sticky; top: 80px;">

                <h2 class="fw-semibold mb-4"
                    style="color: var(--foreground); font-size: 1.125rem;">
                    Booking Summary
                </h2>

                <div class="d-flex flex-column gap-3 mb-4">

                    <div class="booking-summary-row">
                        <span class="booking-summary-label">Court</span>
                        <span class="booking-summary-value">@Model.CourtName</span>
                    </div>

                    <div class="booking-summary-row">
                        <span class="booking-summary-label">Sport</span>
                        <span>
                            @if (Model.SportType == CourtBook.Models.SportType.Badminton)
                            {
                                <span class="badge-badminton">Badminton</span>
                            }
                            else
                            {
                                <span class="badge-pickleball">Pickleball</span>
                            }
                        </span>
                    </div>

                    <div class="booking-summary-row">
                        <span class="booking-summary-label">Rate</span>
                        <span class="booking-summary-value">
                            &#8369;@Model.PricePerHour.ToString("N0") / hour
                        </span>
                    </div>

                    <div class="booking-summary-row">
                        <span class="booking-summary-label">Date</span>
                        <span class="booking-summary-value" id="summaryDate">
                            @(Model.SelectedDate.HasValue
                                ? Model.SelectedDate.Value.ToString("dddd, MMMM d, yyyy")
                                : "—")
                        </span>
                    </div>

                    <div class="booking-summary-row align-items-start">
                        <span class="booking-summary-label pt-1">Selected Slots</span>
                        <div class="d-flex flex-column align-items-end gap-1 text-end" id="summaryTimeSlots">
                            <span class="text-muted" style="font-size: 0.875rem;">—</span>
                        </div>
                    </div>

                    <div id="totalAmountRow"
                         class="border-top pt-3 mt-1 d-none"
                         style="border-color: var(--border) !important;">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex flex-column">
                                <span class="text-uppercase fw-semibold"
                                      style="color: var(--muted-foreground); font-size: 0.7rem; letter-spacing: 0.08em;">
                                    Total Amount
                                </span>
                                <span class="text-muted" id="summaryHourlyMultiplier" style="font-size: 0.75rem;"></span>
                            </div>
                            <span class="fw-bold" style="color: var(--foreground); font-size: 1.25rem;" id="calculatedTotalPrice">
                                &#8369;0
                            </span>
                        </div>
                        <p class="mb-0 mt-1"
                           style="color: var(--muted-foreground); font-size: 0.75rem;">
                            Payment collected upon arrival
                        </p>
                    </div>

                </div>

                <div class="border-top pt-4" style="border-color: var(--border) !important;">
                    <button type="button"
                            id="confirmBtn"
                            class="btn btn-primary w-100 py-3 fw-semibold rounded-3"
                            style="font-size: 1rem;"
                            disabled
                            data-bs-toggle="modal"
                            data-bs-target="#confirmModal"
                            onclick="prepareModal()">
                        Confirm Reservation
                    </button>
                    <div id="confirmHint"
                         class="d-flex align-items-center gap-2 mt-3"
                         style="color: var(--muted-foreground); font-size: 0.75rem;">
                        <i class="bi bi-info-circle"></i>
                        Select at least one time slot block to continue.
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-bottom"
                 style="border-color: var(--border) !important;">
                <h5 class="modal-title fw-semibold"
                    style="color: var(--foreground);">
                    Confirm Booking
                </h5>
                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>
            </div>
            <div class="modal-body py-4">
                <p style="color: var(--muted-foreground); font-size: 0.9rem;">
                    You are about to book @Model.CourtName. Please review your booking details below.
                </p>
                <div class="rounded-3 p-3 mt-3"
                     style="background-color: var(--secondary); border: 1px solid var(--border);">
                    <div class="d-flex flex-column gap-2" style="font-size: 0.875rem;">
                        <div class="d-flex justify-content-between">
                            <span style="color: var(--muted-foreground);">Court</span>
                            <span class="fw-medium" style="color: var(--foreground);">@Model.CourtName</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span style="color: var(--muted-foreground);">Date</span>
                            <span class="fw-medium" style="color: var(--foreground);" id="modalDate"></span>
                        </div>
                        <div class="d-flex justify-content-between align-items-start">
                            <span style="color: var(--muted-foreground);">Time Slots</span>
                            <div class="d-flex flex-column align-items-end gap-1 text-end fw-medium" style="color: var(--foreground);" id="modalTimeSlotsContainer">
                            </div>
                        </div>
                        <div class="d-flex justify-content-between border-top pt-2"
                             style="border-color: var(--border) !important;">
                            <span style="color: var(--muted-foreground);">Total Amount</span>
                            <span class="fw-bold" style="color: var(--foreground);" id="modalTotalPrice"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top"
                 style="border-color: var(--border) !important;">
                <button type="button"
                        class="btn btn-secondary px-4"
                        data-bs-dismiss="modal">
                    Go Back
                </button>
                <form asp-controller="Reservations"
                      asp-action="Book"
                      method="post"
                      id="bookingForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="CourtId" value="@Model.CourtId" />
                    <input type="hidden" name="SelectedDate"
                           value="@Model.SelectedDate?.ToString("yyyy-MM-dd")" />
                    
                    <div id="hiddenSlotsFormPayload"></div>

                    <button type="submit"
                            class="btn btn-primary px-4 fw-semibold">
                        Confirm Booking
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Array tracks our chosen values string arrays ["09:00-10:00", "10:00-11:00"]
        let selectedSlotsList = [];
        const baseRate = parseFloat("@Model.PricePerHour");

        const confirmBtn = document.getElementById('confirmBtn');
        const confirmHint = document.getElementById('confirmHint');
        const summaryTimeSlots = document.getElementById('summaryTimeSlots');
        const totalAmountRow = document.getElementById('totalAmountRow');
        const calculatedTotalPrice = document.getElementById('calculatedTotalPrice');
        const summaryHourlyMultiplier = document.getElementById('summaryHourlyMultiplier');
        const hiddenSlotsFormPayload = document.getElementById('hiddenSlotsFormPayload');

        function toggleSlotSelection(btn) {
            const rawVal = btn.dataset.rawValue;
            const displayText = btn.dataset.displayText;

            const index = selectedSlotsList.findIndex(item => item.rawValue === rawVal);

            if (index > -1) {
                // Already selected, deselect it
                selectedSlotsList.splice(index, 1);
                btn.style.backgroundColor = 'transparent';
                btn.style.borderColor = 'var(--border)';
            } else {
                // Select it
                selectedSlotsList.push({ rawValue: rawVal, displayText: displayText });
                btn.style.backgroundColor = 'var(--primary)';
                btn.style.borderColor = 'var(--primary)';
            }

            updateSummaryLayout();
        }

        function updateSummaryLayout() {
            // Clear prior values
            summaryTimeSlots.innerHTML = '';

            if (selectedSlotsList.length > 0) {
                // Populate display blocks on side panel
                selectedSlotsList.forEach(slot => {
                    const el = document.createElement('span');
                    el.className = 'fw-medium text-foreground';
                    el.style.fontSize = '0.9rem';
                    el.textContent = slot.displayText;
                    summaryTimeSlots.appendChild(el);
                });

                // Calculate total amounts base values
                const totalCost = baseRate * selectedSlotsList.length;
                
                summaryHourlyMultiplier.textContent = `₱${baseRate.toLocaleString()} × ${selectedSlotsList.length} hour(s)`;
                calculatedTotalPrice.innerHTML = `&#8369;${totalCost.toLocaleString('en-US', { minimumFractionDigits: 0 })}`;
                
                totalAmountRow.classList.remove('d-none');
                confirmBtn.disabled = false;
                confirmHint.style.display = 'none';
            } else {
                summaryTimeSlots.innerHTML = '<span class="text-muted" style="font-size: 0.875rem;">—</span>';
                totalAmountRow.classList.add('d-none');
                confirmBtn.disabled = true;
                confirmHint.style.display = 'flex';
            }
        }

        function prepareModal() {
            const dateEl = document.getElementById('summaryDate');
            document.getElementById('modalDate').textContent = dateEl ? dateEl.textContent.trim() : '';
            
            const modalTimeSlotsContainer = document.getElementById('modalTimeSlotsContainer');
            modalTimeSlotsContainer.innerHTML = '';
            hiddenSlotsFormPayload.innerHTML = '';

            selectedSlotsList.forEach(slot => {
                // 1. Append textual representation to view model popup UI
                const textSpan = document.createElement('span');
                textSpan.textContent = slot.displayText;
                modalTimeSlotsContainer.appendChild(textSpan);

                // 2. Build the array name inputs match framework target endpoints parameter name exactly
                const hiddenInput = document.createElement('input');
                hiddenInput.type = 'hidden';
                hiddenInput.name = 'selectedSlots';
                hiddenInput.value = slot.rawValue;
                hiddenSlotsFormPayload.appendChild(hiddenInput);
            });

            // Set pop price label
            document.getElementById('modalTotalPrice').textContent = calculatedTotalPrice.textContent;
        }
    </script>
}